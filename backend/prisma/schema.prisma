generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ALMACENISTA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  auditLogs AuditLog[]
}

enum Role {
  ADMINISTRADOR
  ALMACENISTA
  COMPRAS
  GERENTE
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  description String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Provider {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  transactions InventoryTransaction[]
}

model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique
  barcode     String?   @unique
  name        String
  description String?
  price       Float     @default(0.0)
  stock       Int       @default(0)
  minStock    Int       @default(5)
  imageUrl    String?
  
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id          Int       @id @default(autoincrement())
  type        TransactionType
  quantity    Int
  date        DateTime  @default(now())
  notes       String?
  
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  
  providerId  Int?
  provider    Provider? @relation(fields: [providerId], references: [id])
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  module      String
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}
